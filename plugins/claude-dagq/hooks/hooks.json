{
  "description": "Re-orient a dagq inbox or planner session at its start, resume, compaction or /clear by printing the queue's status for its role (the inbox first told to start its watch), keep the inbox from ending a turn without a watch, and record the session's span (kind, session id, start and end) in the queue.",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/session-start.sh\""
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/session-event.sh\" open"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/stop-watch.sh\""
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/session-event.sh\" close"
          }
        ]
      }
    ]
  }
}
