# The image of the dagq resource broker (docs/design/broker.md "image",
# ADR-t827-3 decision 8). dagq embeds its build context in its binary
# (build.rs, src/broker_material.rs) and unpacks it to build the image
# (src/infrastructure/broker_image.rs): a build from a checkout embeds this
# file, the sources of dagq-broker-protocol and dagq-broker, Cargo.lock, and
# a workspace manifest narrowed to those two crates; a release (dagq's
# crates.io package, without crates/) embeds this file alone, with the lines
# between the two `dagq:build-from-source` markers replaced by
# `cargo install --locked dagq-broker@<version>` with the same caches. It
# builds in dagq's own Podman machine with `--build-arg RUST_VERSION` (from
# rust-toolchain.toml), `--build-arg CARGO_BUILD_JOBS=1` (the machine is
# small) and `--build-arg DAGQ_BROKER_IMAGE_BUILD=<dagq's build identifier>`.
#
# The build keeps cargo's registry and target directory in two cache mounts
# (`--mount=type=cache`, task 1451): they are not images, so neither the
# start's `podman image rm` of old tags nor its `podman image prune --force`
# of dangling images removes them (only `--build-cache` would), and a build
# whose Cargo.lock and Rust are the same compiles none of the dependencies
# again. `sharing=locked` lets one build at a time use them.

ARG RUST_VERSION=1.98.1

FROM docker.io/library/rust:${RUST_VERSION}-alpine AS build
ARG CARGO_BUILD_JOBS=1
RUN apk add --no-cache musl-dev
# dagq's build identifier (`--build-arg DAGQ_BROKER_IMAGE_BUILD`): the build
# stage has no Git, so the server embeds this one and its health names the
# build of the dagq that built the image (ADR-t827-1 decision 7). Declared
# after the layers that do not use it, as it changes with each build.
ARG DAGQ_BROKER_IMAGE_BUILD=
# dagq:build-from-source begin
WORKDIR /src
COPY . .
# No --locked: Cargo.lock is the whole workspace's, and only the lines of
# the packages this narrowed workspace does not use go; the versions of the
# ones it uses stay as locked. The context's files are touched first, so
# cargo sees them newer than anything in the cached target and compiles the
# two crates again (the build identifier reruns the server's build script
# too), whatever times COPY gave them; the dependencies stay compiled.
RUN --mount=type=cache,id=dagq-broker-cargo-registry,target=/usr/local/cargo/registry,sharing=locked \
    --mount=type=cache,id=dagq-broker-cargo-target,target=/src/target,sharing=locked \
    find crates -type f -exec touch {} + \
 && cargo build --release -p dagq-broker \
 && install -m 0755 target/release/dagq-broker /dagq-broker
# dagq:build-from-source end

# The run stage: the broker and git only, no language toolchain
# (ADR-t827-3 decision 9), and a non-root user. `podman run --userns=keep-id`
# maps the host user's uid over it so the mounted files' owner matches.
FROM docker.io/library/alpine:3
RUN apk add --no-cache git \
 && adduser -D -H -u 10001 broker
COPY --from=build /dagq-broker /usr/local/bin/dagq-broker
USER 10001
EXPOSE 8750
ENTRYPOINT ["/usr/local/bin/dagq-broker"]
