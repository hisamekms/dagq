@@ -19,3 +19,10 @@ def test_users_do_not_see_each_others_notes():
     store = NoteStore()
     store.add("ann", "buy milk")
     assert store.list("bob") == []
+
+
+def test_a_snapshot_holds_every_users_notes():
+    store = NoteStore()
+    store.add("bob", "call ann")
+    store.add("ann", "buy milk")
+    assert store.snapshot() == {"ann": ["buy milk"], "bob": ["call ann"]}
