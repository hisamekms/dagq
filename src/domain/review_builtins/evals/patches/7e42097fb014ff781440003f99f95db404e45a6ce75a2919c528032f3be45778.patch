@@ -14,3 +14,10 @@ test("taking more than is in stock is refused", () => {
   assert.throws(() => ledger.take("pen", 2));
   assert.equal(ledger.count("pen"), 1);
 });
+
+test("the total adds every item", () => {
+  const ledger = new Ledger();
+  ledger.add("pen", 3);
+  ledger.add("ink", 2);
+  ledger.total();
+});
