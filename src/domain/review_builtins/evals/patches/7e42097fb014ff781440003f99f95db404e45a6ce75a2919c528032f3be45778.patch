diff --git a/src/ledger.js b/src/ledger.js
index 65d5cd8..e34cc32 100644
--- a/src/ledger.js
+++ b/src/ledger.js
@@ -19,4 +19,12 @@ export class Ledger {
   count(item) {
     return this.items.get(item) ?? 0;
   }
+
+  total() {
+    let sum = 0;
+    for (const quantity of this.items.values()) {
+      sum += quantity;
+    }
+    return sum;
+  }
 }
diff --git a/test/ledger.test.js b/test/ledger.test.js
