diff --git a/notes/store.py b/notes/store.py
index 5bb044b..855eec6 100644
--- a/notes/store.py
+++ b/notes/store.py
@@ -1,5 +1,7 @@
 """Keeps each user's notes in memory."""
 
+MAX_NOTES = 100
+
 
 class NoteStore:
     def __init__(self):
@@ -8,8 +10,11 @@ class NoteStore:
     def add(self, user, text):
         if not text.strip():
             raise ValueError("a note needs text")
-        self._notes.setdefault(user, []).append(text)
-        return len(self._notes[user])
+        notes = self._notes.setdefault(user, [])
+        if len(notes) >= MAX_NOTES:
+            raise ValueError(f"a user keeps at most {MAX_NOTES} notes")
+        notes.append(text)
+        return len(notes)
 
     def list(self, user):
         return list(self._notes.get(user, []))
diff --git a/tests/test_store.py b/tests/test_store.py
index cd5ce70..43c0c95 100644
--- a/tests/test_store.py
+++ b/tests/test_store.py
@@ -1,6 +1,6 @@
 import pytest
 
-from notes.store import NoteStore
+from notes.store import MAX_NOTES, NoteStore
 
 
 def test_a_note_is_listed_after_it_is_added():
@@ -15,6 +15,22 @@ def test_an_empty_note_is_refused():
         store.add("ann", "  ")
 
 
+def test_a_user_keeps_up_to_the_limit_and_no_more():
+    store = NoteStore()
+    for n in range(MAX_NOTES):
+        store.add("ann", f"note {n}")
+    with pytest.raises(ValueError):
+        store.add("ann", "one too many")
+    assert len(store.list("ann")) == MAX_NOTES
+
+
+def test_the_limit_is_each_users_own():
+    store = NoteStore()
+    for n in range(MAX_NOTES):
+        store.add("ann", f"note {n}")
+    assert store.add("bob", "first") == 1
+
+
 def test_users_do_not_see_each_others_notes():
     store = NoteStore()
     store.add("ann", "buy milk")
