 script = "scripts/check-adr-numbers.sh"
 paths = ["docs/adr/**"]
 
+# Codex で動く agent の eval の周の見積もりと金額への換算。Codex は金額を返さないので単価が無いと cost_unknown で拒まれ、
+# 同じ agent・provider の実績が無いうちは default_run_usd が無いとやはり拒まれる（domain::agent_eval::round の estimate）。
+# 対象の model は gpt-6.1-sol（queue の review_job_finished の model の欄で、2026-10-25〜11-01 の Codex の review の agent の job はどれもこれ）。
+# 単価は OpenAI の公開の価格の頁 https://developers.openai.com/api/docs/pricing の Standard の Short（272K 以下）の行（2026-11-02 に見た）:
+# input $2.00・cached input $0.10・output $10.00（1M token あたり）。272K を超える入力の Long の行（$4.00・$0.20・$15.00）と cache write の単価は使わない
+# （換算は cache_creation も cached input の単価で数える）。
+# default_run_usd は Claude の既定（Spike の実測の 1 回の 2 倍）に揃えた初回の 1 回の見込み: 2026-10-25〜11-01 の Codex の review の agent の job 80 件の
+# 中央値の目安 input 47,000・cache_read 150,000・output 1,200 token を上の単価で換算すると 0.094 + 0.015 + 0.012 = $0.121 で、その 2 倍の $0.242。
+# 実績が溜まれば見込みは recent_runs の実績の最大に替わる。model か公開の単価が変わったら、単価と default_run_usd を見直す。
+[eval.providers.codex]
+input_usd_per_mtok = 2.0
+cached_input_usd_per_mtok = 0.1
+output_usd_per_mtok = 10.0
+default_run_usd = 0.242
+
