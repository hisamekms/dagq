+/// The shell line that lists the commits of the run branch `branch` not
+/// yet on `base`, every argument quoted on its own ([`shell_join`]).
+pub fn branch_log_command(repo: &Path, base: &str, branch: &str) -> String {
+    shell_join(&[
+        "git".to_owned(),
+        "-C".to_owned(),
+        repo.display().to_string(),
+        "log".to_owned(),
+        "--oneline".to_owned(),
+        format!("{base}..{branch}"),
+    ])
+}
