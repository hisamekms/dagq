@@ -681,3 +681,15 @@ fn zombie(pid: u32) -> bool {
         .trim()
         .starts_with('Z')
 }
+
+/// The payloads of the queue's events of `kind`, oldest first.
+fn payloads_of(db: &Path, kind: EventKind) -> Vec<serde_json::Value> {
+    SqliteQueue::open(db)
+        .unwrap()
+        .all_events()
+        .unwrap()
+        .into_iter()
+        .filter(|event| event.kind == kind)
+        .map(|event| event.payload)
+        .collect()
+}
