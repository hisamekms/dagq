+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    /// A page whose diagram is an `<img>` of a base64 SVG gives the SVG back
+    /// and the page without it.
+    #[test]
+    fn a_diagram_image_is_read_back() {
+        let svg = "<svg/>";
+        let page = format!(
+            "<p>a</p><div class=\"scroll diagram\"><img src=\"{}PHN2Zy8+\"></div><p>b</p>",
+            dagq::domain::kpi::report::IMAGE_PREFIX
+        );
+        let (read, rest) = diagram_image(&page).unwrap();
+        assert_eq!(read, svg);
+        assert_eq!(rest, "<p>a</p><p>b</p>");
+    }
+
+    #[test]
+    fn a_page_without_a_diagram_has_none() {
+        assert_eq!(diagram_image("<p>a</p>"), None);
+    }
+}
