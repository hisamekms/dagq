+    let draining = queue
+        .all_events()
+        .unwrap()
+        .into_iter()
+        .find(|event| event.kind == "supervisor_draining")
+        .unwrap();
+    assert_eq!(draining.payload["runs"], json!([run.id()]));
+    fs::write(
+        Path::new(run.run_dir().unwrap()).join("exit-requested.go"),
+        "",
