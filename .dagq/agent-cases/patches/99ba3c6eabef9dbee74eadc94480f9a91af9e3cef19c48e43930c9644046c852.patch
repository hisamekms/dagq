+/// The shell line that lists the commits of the run branch `branch`
+/// (the task's title made into a branch name) not yet on `base`, for the
+/// review's material.
+pub fn branch_log_command(repo: &Path, base: &str, branch: &str) -> String {
+    format!(
+        "git -C {} log --oneline {base}..{branch}",
+        shell_quote(&repo.display().to_string())
+    )
+}
