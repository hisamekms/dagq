+//! Share the reports the supervisor wrote with the team: each daily and
+//! weekly report's HTML and JSON are uploaded to the URL of
+//! `host.toml`'s `[report] share_url`, so that people away from the host
+//! read them in a browser.
+
+use std::path::Path;
+use std::process::Command;
+
+use anyhow::{Result, ensure};
+
+use crate::application::report::Written;
+
+/// Upload `written`'s HTML and JSON to `url` as one multipart form.
+pub fn share(written: &Written, url: &str) -> Result<()> {
+    let status = Command::new("curl")
+        .args(["--silent", "--show-error", "--fail", "--max-time", "30"])
+        .arg("-F")
+        .arg(form("html", &written.html))
+        .arg("-F")
+        .arg(form("json", &written.json))
+        .arg(url)
+        .status()?;
+    ensure!(status.success(), "curl ended with {status}");
+    Ok(())
+}
+
+fn form(name: &str, file: &Path) -> String {
+    format!("{name}=@{}", file.display())
+}
