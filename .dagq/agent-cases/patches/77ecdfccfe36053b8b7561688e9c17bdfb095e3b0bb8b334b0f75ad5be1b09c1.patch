+
+/// A supervisor's registration made through the service is read back by a
+/// second service process started on the same queue after the first one
+/// stopped: the registration is in the queue's file, not in the process
+/// that took it, and the supervisor's own process never opens the queue
+/// (ADR-t3102-3 decision 3).
+#[test]
+fn a_registration_through_the_service_outlives_the_services_process() {
+    let (_fixture, _repo, db) = fixture();
+    let served = common::service::Served::start(&db);
+    let pid = 4244;
+    let caller: Arc<dyn ServiceCaller> = Arc::new(SocketCaller::new(&db));
+    let shared = SupervisorQueues::new(
+        caller.clone(),
+        ActorContext::instance(ActorRole::Supervisor, pid),
+    );
+    let refused = refuse_opening(&db);
+    let token = LeaseToken::new("supervisor-across-service-processes");
+    caller.sign_in(&token, pid).unwrap();
+    let limits = SlotLimits::resolve(SlotFlags::default(), &SupervisorConfig::default());
+    shared
+        .open()
+        .unwrap()
+        .register_supervisor(&token, pid, limits, &[], "0.0.0-test")
+        .unwrap();
+
+    // The first service goes; the second one answers from the same file.
+    drop(served);
+    let served = common::service::Served::start(&db);
+    let mut again = shared.open().unwrap();
+    assert!(again.heartbeat(&token).unwrap().registered);
+    // The same supervisor, holding no lease of a run it never claimed.
+    assert_eq!(again.heartbeat_leases(&token).unwrap(), 0);
+    drop(again);
+
+    drop(served);
+    drop(refused);
+    caller.sign_out();
+}
