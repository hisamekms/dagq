+/// The message's stdin with the whole report after it: the summary and,
+/// for a daily or weekly message, the report's JSON as written, so the
+/// phone shows every KPI without opening the queue's `reports/`.
+fn with_report(message: &PushMessage) -> Vec<u8> {
+    let mut bytes = message.stdin();
+    if let Some(json) = &message.report_json
+        && let Ok(report) = std::fs::read(json)
+    {
+        bytes.extend_from_slice(&report);
+        bytes.push(b'\n');
+    }
+    bytes
+}
