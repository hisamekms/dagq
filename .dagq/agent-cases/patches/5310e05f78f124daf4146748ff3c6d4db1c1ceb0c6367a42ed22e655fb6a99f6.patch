@@ -550,3 +550,27 @@ pub fn await_file(word: &str) -> String {
 pub fn await_path(path: impl AsRef<std::path::Path>) -> String {
     await_file(&shell_path(path))
 }
+
+/// Task 1's run claimed under the supervisor's lease `token` on `base`,
+/// set to await integration with no lease left: the start of the runtime
+/// tests of a landing that lands nothing (`host_control`).
+pub fn claimed_awaiting_run(db: &std::path::Path, base: &str, token: &str) -> dagq::domain::TaskRun {
+    use dagq::domain::{ClaimOutcome, CommitSha, LeaseToken};
+    let mut queue = dagq::infrastructure::sqlite::SqliteQueue::open(db).unwrap();
+    let base = CommitSha::parse(base, "base commit").unwrap();
+    let ClaimOutcome::Claimed { run } = queue
+        .claim_for_supervisor(&base, &LeaseToken::new(token))
+        .unwrap()
+    else {
+        panic!("task 1 is not claimed")
+    };
+    let raw = rusqlite::Connection::open(db).unwrap();
+    raw.execute(
+        "UPDATE task_runs SET status='awaiting_integration' WHERE id=?1",
+        [run.id().as_str()],
+    )
+    .unwrap();
+    raw.execute("DELETE FROM run_leases WHERE run_id=?1", [run.id().as_str()])
+        .unwrap();
+    queue.run(run.id()).unwrap()
+}
