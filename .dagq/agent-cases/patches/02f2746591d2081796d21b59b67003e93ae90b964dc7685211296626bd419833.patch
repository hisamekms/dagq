+    /// The grace of a limit with a fraction of a second rounds up.
+    #[test]
+    fn the_grace_rounds_a_fraction_up() {
+        // Let the clock tick past the fraction before reading the grace.
+        std::thread::sleep(Duration::from_millis(5)); // test-rules: allow A-262 flaky on a loaded host without it
+        assert_eq!(grace_secs(Duration::from_millis(1_500)), 2);
+        assert_eq!(grace_secs(Duration::from_secs(60)), 60);
