+/// A task with no verification command lands in one pass of the
+/// supervisor.
+#[test]
+fn a_task_without_verification_lands_in_one_pass() {
+    let fixture = fixture();
+    let Fixture { env, .. } = &fixture;
+    let task_id = add_ready_task(env, "e2e task without verify", &[]);
+    let pass = supervise_once(&fixture, &[], &[&task_id]);
+    assert_eq!(pass.outcome["outcome"], "finished", "{}", pass.outcome);
+    assert_eq!(
+        dagq(env, &["show", &task_id])["task"]["status"],
+        "completed"
+    );
+}
