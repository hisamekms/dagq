+    assert_eq!(ask.task_id, Some(follow_up));
+    assert_eq!(ask.run_id, None);
+    assert_eq!(ask.reason_category, dagq::domain::AskReason::Scope);
+    assert_eq!(ask.options, ["reopen", "correct_verdict", "keep_achieved"]);
+    for part in [
