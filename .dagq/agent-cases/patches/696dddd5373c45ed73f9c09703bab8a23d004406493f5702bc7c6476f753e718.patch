+//! The KPI push through the command line: `kpi` with a host's `[push]`
+//! sends nothing by itself; the supervisor's daily pass does.
+use std::process::Command;
+
+use serde_json::Value;
+
+#[test]
+fn kpi_alone_runs_no_push_command() {
+    let dir = tempfile::tempdir().unwrap();
+    let db = dir.path().join("queue.db");
+    let mark = dir.path().join("pushed");
+    std::fs::write(
+        dir.path().join("host.toml"),
+        format!("[push]\ncommand = [\"touch\", {:?}]\n", mark),
+    )
+    .unwrap();
+    let init = Command::new(env!("CARGO_BIN_EXE_dagq"))
+        .args(["--db", db.to_str().unwrap(), "init"])
+        .output()
+        .unwrap();
+    assert!(init.status.success());
+    let output = Command::new(env!("CARGO_BIN_EXE_dagq"))
+        .args(["--db", db.to_str().unwrap(), "kpi", "--period", "day"])
+        .output()
+        .unwrap();
+    assert!(output.status.success());
+    let kpi: Value = serde_json::from_slice(&output.stdout).unwrap();
+    assert!(kpi["periods"].is_array());
+    assert!(!mark.exists());
+}
