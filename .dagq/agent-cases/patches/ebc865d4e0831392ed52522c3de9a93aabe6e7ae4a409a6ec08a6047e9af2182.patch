+        for depth in [0, 1, 2, 3, 4] {
+            for current in [false, true] {
+                for source in [false, true] {
+                    let needs = adopt_needs_person(FollowUpFacts {
+                        goal_open: current,
+                        source_goal_open: source,
+                        depth,
+                    })
+                    .is_some();
+                    assert_eq!(needs, !source || !current || depth >= 3);
+                }
+            }
+        }
+    }
+}
