+/// The operation of `run` once it is requested: asked for as `inbox` with the
+/// reason "the review keeps sending it back", read back through `dagq replan show` and checked to
+/// be `candidate`, with the task's conditions it began with.
+fn operation_requested(db: &std::path::Path, run: &RunId, conditions: &[&str]) -> Value {
+    let answer = ok_as("inbox", db, &args(&request(run, "the review keeps sending it back")));
+    let id = answer["operation"]["id"].as_i64().unwrap();
+    let shown = ok(db, &["replan", "show", &id.to_string()]);
+    let op = &shown["operation"];
+    assert_eq!(op["status"], "candidate", "{shown}");
+    let items: Vec<&str> = op["conditions"]["acceptance"]
+        .as_array()
+        .unwrap()
+        .iter()
+        .map(|item| item["text"].as_str().unwrap())
+        .collect();
+    assert_eq!(items, conditions, "{shown}");
+    op.clone()
+}
