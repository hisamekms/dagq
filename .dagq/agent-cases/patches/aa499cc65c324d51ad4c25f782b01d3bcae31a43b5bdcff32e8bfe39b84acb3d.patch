+
+    /// Waits opened at the given times inside a 1200s run, with their
+    /// limits and the deadline each gets.
+    static OPENED: [(u64, u64, u64); 3] = [(0, 300, 300), (1000, 300, 1140), (1190, 60, 1140)];
+
+    #[test]
+    fn each_wait_of_the_table_gets_its_deadline() {
+        for (at, limit, deadline) in OPENED {
+            assert_eq!(
+                nested_deadline(secs(at), secs(limit), Some(secs(1200)), WAIT_MARGIN),
+                secs(deadline),
+                "{at} {limit}"
+            );
+        }
+    }
