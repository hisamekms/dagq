+) -> String {
+    let list = follow_ups
+        .iter()
+        .map(|(task, why)| format!("{task} ({})", why.as_str()))
+        .collect::<Vec<_>>()
+        .join(", ");
+    format!("goal {goal}: its goal review waits for the membership of follow-ups {list}")
+}
