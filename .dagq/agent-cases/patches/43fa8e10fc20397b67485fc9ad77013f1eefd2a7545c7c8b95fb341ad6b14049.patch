+pub struct GoalFollowUps {
+    pub goal: super::GoalId,
+    pub tasks: Vec<(super::TaskId, super::TaskStatus)>,
+    pub follow_ups: Vec<WaitingFollowUp>,
+}
+
+/// The follow-ups that alone keep the goal review from starting and that
