+          elif ! git cat-file -e "$BASE^{commit}" 2>/dev/null; then
+            echo "skipped: the base commit $BASE is not in the history (a force push)"
+          else
+            sh scripts/check-it-test-time.sh --base "$BASE" "$RUNNER_TEMP/nextest.log"
