@@ -0,0 +1,20 @@
+[package]
+name = "dagq-domain"
+version = "0.4.0-dev"
+edition = "2024"
+rust-version = "1.98"
+description = "The domain layer of dagq: aggregates, value types and business decisions, with no I/O"
+license = "MIT"
+publish = false
+
+[dependencies]
+serde = { version = "1.0", features = ["derive"] }
+serde_json = "1.0"
+sha2 = "0.10"
+# Provisional for the prototype: the ToSql/FromSql impls of the ID newtypes
+# (src/infrastructure/sql_ids.rs) moved here because of the orphan rule.
+rusqlite = { version = "0.40", features = ["backup", "bundled", "functions", "hooks"] }
+
+[features]
+# The test helpers dagq's own tests use (cfg(test) does not cross crates).
+testkit = []
