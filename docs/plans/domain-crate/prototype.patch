diff --git a/crates/dagq-domain/src/build_id.rs b/crates/dagq-domain/src/build_id.rs
new file mode 100644
index 00000000..dd812bb7
--- /dev/null
+++ b/crates/dagq-domain/src/build_id.rs
@@ -0,0 +1,18 @@
+//! The I/O-free rule of the build identifier, copied from dagq's
+//! `src/build_id.rs` for the prototype (build.rs includes that file by path,
+//! so it cannot depend on this crate).
+
+pub const UNKNOWN_COMMIT: &str = "unknown";
+
+/// The commit a build identifier names (see dagq's `build_id::named_commit`).
+pub fn named_commit(build: &str) -> Option<&str> {
+    let (_, metadata) = build.split_once('+')?;
+    let commit = metadata.strip_suffix(".dirty").unwrap_or(metadata);
+    (commit != UNKNOWN_COMMIT && !commit.is_empty()).then_some(commit)
+}
+
+/// Whether `version` has a SemVer pre-release (see dagq's
+/// `build_id::is_prerelease`).
+pub fn is_prerelease(version: &str) -> bool {
+    version.split('+').next().unwrap_or(version).contains('-')
+}
